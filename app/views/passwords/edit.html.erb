<% content_for :title, "Yeni parola · DestekAkış" %>

<div class="auth-header">
  <h1>Yeni parolanı belirle</h1>
  <p>Parolan en az <%= User::MINIMUM_PASSWORD_LENGTH %> karakter olmalı.</p>
</div>

<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <div class="field">
    <%= form.label :password, "Yeni parola" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Yeni parolan", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Yeni parola (tekrar)" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Yeni parolanı tekrar gir", maxlength: 72 %>
  </div>

  <%= form.submit "Parolayı kaydet", class: "button button-block", data: { turbo_submits_with: "Kaydediliyor…" } %>
<% end %>
