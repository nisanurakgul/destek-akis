<% content_for :title, "Talebi düzenle ##{@ticket.id} · DestekAkış" %>

<header class="page-header">
  <div class="page-heading">
    <nav class="breadcrumb" aria-label="Konum">
      <%= link_to "Talepler", tickets_path %><%= icon("chevron-right", size: 14) %><%= link_to "##{@ticket.id}", @ticket %><%= icon("chevron-right", size: 14) %><span aria-current="page">Düzenle</span>
    </nav>
    <h1 class="page-title">Talebi düzenle #<%= @ticket.id %></h1>
    <p class="page-subtitle">Konu, açıklama, talep eden, öncelik ve atanan kişi bilgilerini güncelle.</p>
  </div>
</header>

<div class="narrow">
  <%= render "form", ticket: @ticket, users: @users %>
</div>
