<% content_for :title, "Talepler · DestekAkış" %>

<header class="page-header">
  <div class="page-heading">
    <h1 class="page-title">Talepler</h1>
    <p class="page-subtitle">Toplam <%= @tickets.size %> talep · en yeniden en eskiye</p>
  </div>
  <div class="page-actions">
    <%= link_to new_ticket_path, class: "button" do %><%= icon("plus") %>Yeni talep<% end %>
  </div>
</header>

<% if @tickets.any? %>
  <div class="card card-flush">
    <div class="table-wrap">
      <table class="data-table ticket-table">
        <thead>
          <tr>
            <th scope="col" class="col-id">#</th>
            <th scope="col">Konu</th>
            <th scope="col">Talep eden</th>
            <th scope="col">Durum</th>
            <th scope="col">Öncelik</th>
            <th scope="col">Atanan</th>
            <th scope="col">Oluşturulma</th>
          </tr>
        </thead>
        <tbody>
          <% @tickets.each do |ticket| %>
            <tr id="<%= dom_id(ticket) %>">
              <td class="col-id"><%= ticket.id %></td>
              <td class="col-subject" data-id="#<%= ticket.id %>"><%= link_to ticket.subject, ticket, class: "row-link" %></td>
              <td class="col-requester"><%= ticket.requester_name %></td>
              <td class="col-status"><%= status_badge(ticket) %></td>
              <td class="col-priority"><%= priority_badge(ticket) %></td>
              <td class="col-assignee"><%= assignee_with_avatar(ticket) %></td>
              <td class="col-date"><time datetime="<%= ticket.created_at.iso8601 %>"><%= format_datetime(ticket.created_at) %></time></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card empty-state">
    <span class="empty-state-icon"><%= icon("inbox", size: 24) %></span>
    <h2>Henüz talep yok</h2>
    <p class="empty">Müşterilerden gelen ilk destek talebini oluşturarak başlayabilirsin.</p>
    <%= link_to new_ticket_path, class: "button" do %><%= icon("plus") %>İlk talebi oluştur<% end %>
  </div>
<% end %>
