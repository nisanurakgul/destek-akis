<h1>Users</h1>

<p><%= link_to "New user", new_user_path %></p>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email_address %></td>
        <td><%= user.role %></td>
      </tr>
    <% end %>
  </tbody>
</table>
