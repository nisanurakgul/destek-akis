<h1>New user</h1>

<%= form_with model: @user do |form| %>
  <% if @user.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@user.errors.count, "error") %> prevented this user from being saved:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= form.label :name %><br>
    <%= form.text_field :name, required: true %>
  </p>

  <p>
    <%= form.label :email_address, "Email" %><br>
    <%= form.email_field :email_address, required: true, autocomplete: "off" %>
  </p>

  <p>
    <%= form.label :role %><br>
    <%= form.select :role, User.roles.keys.map { |role| [ role.humanize, role ] } %>
  </p>

  <p>
    <%= form.label :password %><br>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72 %>
  </p>

  <p>
    <%= form.label :password_confirmation %><br>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </p>

  <%= form.submit "Create user" %>
<% end %>

<p><%= link_to "Back to users", users_path %></p>
